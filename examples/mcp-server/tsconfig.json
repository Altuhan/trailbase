{
  "compilerOptions": {
    "target": "es2022",
    "module": "es2022",
    "moduleResolution": "bundler",
    "paths": {
      // Path alias used inside the workspace `trailbase` client sources,
      // which tsc follows when type-checking this package.
      "@bindings/*": ["../../crates/assets/js/client/bindings/*"]
    },
    "types": ["node"],
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true
  },
  "include": ["src", "tests", "vite.config.ts", "vitest.config.ts"]
}
